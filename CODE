void drawCenteredText(int y, const char* text, int textSize) {
  int16_t x1, y1; uint16_t w, h;
  display.setTextSize(textSize);
  display.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_WIDTH - w) / 2, y);
  display.print(text);
}

void drawClock() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    display.clearDisplay();
    drawCenteredText(25, "Waiting for", 1);
    drawCenteredText(40, "NTP...", 1);
    display.display();
    return;
  }

  int hour24 = timeinfo.tm_hour;
  int minute = timeinfo.tm_min;
  int second = timeinfo.tm_sec;
  int hour12 = hour24 % 12;
  if (hour12 == 0) hour12 = 12;

  char timeStr[10];
  sprintf(timeStr, "%02d:%02d:%02d", hour12, minute, second);

  int year  = timeinfo.tm_year + 1900;
  int month = timeinfo.tm_mon + 1;
  int day   = timeinfo.tm_mday;
  String dateStr = String(day) + "/" + String(month) + "/" + String(year);

  const char* weekdays[] = {"SUNDAY","MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY"};
  String dayOfWeek = weekdays[timeinfo.tm_wday];

  display.clearDisplay();
  drawCenteredText(6, dayOfWeek.c_str(), 1);
  drawCenteredText(25, timeStr, 2);
  drawCenteredText(55, dateStr.c_str(), 1);
  display.display();
}

void drawUptime() {
  unsigned long us = millis() / 1000;
  char buf[32];
  sprintf(buf, "%02lu:%02lu:%02lu", us/3600, (us%3600)/60, us%60);
  display.clearDisplay();
  drawCenteredText(6, "NANO UPTIME", 1);
  drawCenteredText(30, buf, 2);
  display.display();
}

void fetchWeather() {
  if (WiFi.status() != WL_CONNECTED) return;
  HTTPClient http;
  String url = "http://api.openweathermap.org/data/2.5/weather?q="
               + city + "," + countryCode + "&appid=" + apiKey + "&units=metric";
  http.begin(url);
  if (http.GET() == 200) {
    DynamicJsonDocument doc(1024);
    deserializeJson(doc, http.getString());
    temperature = doc["main"]["temp"];
    weatherDesc = doc["weather"][0]["main"].as<String>();
  }
  http.end();
  lastWeatherFetch = millis();
}

void drawWeather() {
  display.clearDisplay();
  drawCenteredText(5, "DHAKA WEATHER", 1);
  char tempStr[10];
  dtostrf(temperature, 4, 1, tempStr);
  String td = String(tempStr) + " C";
  display.setTextSize(2);
  int16_t x1,y1; uint16_t w,h;
  display.getTextBounds(td.c_str(), 0, 0, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_WIDTH - w) / 2, 25);
  display.print(td);
  display.setTextSize(1);
  drawCenteredText(50, weatherDesc.c_str(), 1);
  display.display();
}

void drawNotification() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  if (blinkState) {
    display.setCursor(0, 0);
    display.println("NEW NOTIFICATION");
    display.println(incomingMessage);
  }
  display.display();
}

void softAlert() {
  for (int i = 0; i < 3; i++) {
    digitalWrite(BUZZER_PIN, HIGH); delay(20);
    digitalWrite(BUZZER_PIN, LOW);  delay(50);
  }
}

void handleWiFiClient() {
  WiFiClient client = server.available();
  if (!client) return;
  String request = client.readStringUntil('\r');

  int msgIndex = request.indexOf("msg=");
  if (msgIndex != -1) {
    String newMsg = request.substring(msgIndex + 4);
    int endIndex = newMsg.indexOf(" ");
    if (endIndex != -1) newMsg = newMsg.substring(0, endIndex);
    newMsg.replace("%20", " ");
    newMsg.replace("%0A", "\n");
    incomingMessage   = newMsg;
    notificationActive = true;
    blinkState        = false;
    lastBlinkTime     = millis();
    softAlert();
  }

  if (request.indexOf("clear=1") != -1) {
    incomingMessage    = "";
    notificationActive = false;
    lastDisplayUpdate  = 0;
  }

  client.println("HTTP/1.1 200 OK");
  client.println("Content-type:text/html");
  client.println();
  client.println("OK");
  client.flush();
}

void handleClockButton() {
  static int lastState = HIGH;
  int state = digitalRead(BUTTON_CLOCK_PIN);

  if (state == LOW && lastState == HIGH) {
    if (eyesActive) {
      eyesActive = false;
      lastDisplayUpdate = 0;
      Serial.println("Eyes deactivated by D13");
      delay(DEBOUNCE_MS);
      lastState = state;
      return;
    }
    unsigned long now = millis();
    if (!waitingForSecondPress) {
      waitingForSecondPress = true;
      lastClockBtnPress    = now;
      clockBtnPressCount   = 1;
    } else {
      if (now - lastClockBtnPress <= DOUBLE_CLICK_WINDOW) {
        clockBtnPressCount++;
        if (clockBtnPressCount == 2) {
          currentClockMode = MODE_WEATHER;
          modeStartTime    = now;
          fetchWeather();
          lastDisplayUpdate = 0;
          waitingForSecondPress = false;
          clockBtnPressCount    = 0;
        }
      } else {
        waitingForSecondPress = false;
        clockBtnPressCount    = 0;
        if (currentClockMode == MODE_CLOCK)        { currentClockMode = MODE_UPTIME; modeStartTime = now; }
        else if (currentClockMode == MODE_UPTIME)  { currentClockMode = MODE_CLOCK; }
        else if (currentClockMode == MODE_WEATHER) { currentClockMode = MODE_CLOCK; }
      }
    }
    delay(DEBOUNCE_MS);
  }
  lastState = state;

  if (!eyesActive && waitingForSecondPress && (millis() - lastClockBtnPress > DOUBLE_CLICK_WINDOW)) {
    waitingForSecondPress = false;
    clockBtnPressCount    = 0;
    unsigned long now = millis();
    if (currentClockMode == MODE_CLOCK)        { currentClockMode = MODE_UPTIME; modeStartTime = now; }
    else if (currentClockMode == MODE_UPTIME)  { currentClockMode = MODE_CLOCK; }
    else if (currentClockMode == MODE_WEATHER) { currentClockMode = MODE_CLOCK; }
  }
}

void processTimerBtn1Count(int count) {
  if (count == 1) {
    currentTimerState = TIMER_45MIN;
    timerOriginal     = 2700;
    timerSeconds      = 2700;
    timerRunning      = false;
    buzzerActive = false;
    digitalWrite(BUZZER_PIN, LOW);
  } else if (count == 2) {
    currentTimerState = TIMER_10MIN;
    timerOriginal     = 600;
    timerSeconds      = 600;
    timerRunning      = false;
    buzzerActive = false;
    digitalWrite(BUZZER_PIN, LOW);
  } else {
    currentTimerState = TIMER_NONE;
    timerRunning      = false;
    buzzerActive = false;
    digitalWrite(BUZZER_PIN, LOW);
  }
  timerBtn1Count = 0;
}

String formatTime(long secs) {
  if (secs < 0) secs = 0;
  char buf[8];
  snprintf(buf, sizeof(buf), "%02d:%02d", (int)(secs/60), (int)(secs%60));
  return String(buf);
}

long getRemaining() {
  if (!timerRunning) return timerSeconds;
  long elapsed = (millis() - timerStartMs) / 1000;
  long rem = timerSeconds - elapsed;
  return (rem < 0) ? 0 : rem;
}

void drawTimer(const char* label, long remaining) {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print(label);

  display.setTextSize(3);
  String t = formatTime(remaining);
  int16_t tx = (SCREEN_WIDTH - (int)t.length() * 18) / 2;
  display.setCursor(tx, 18);
  display.print(t);

  display.setTextSize(1);
  display.setCursor(0, 54);
  if (timerRunning)        display.print("Running^_^  Btn=Stop");
  else if (remaining == 0) display.print("DONE!^.^    Btn=Reset");
  else                     display.print("Paused-_-   Btn=Start");

  display.display();
}

