void setupEyes() {
  // Set eye appearance
  roboEyes.setWidth(36, 36);
  roboEyes.setHeight(25, 25);
  roboEyes.setBorderradius(8, 8);
  roboEyes.setSpacebetween(10);
  roboEyes.setCuriosity(ON);
  
  // Start with default settings (will be called once)
  roboEyes.begin(SCREEN_WIDTH, SCREEN_HEIGHT, 100);
  roboEyes.setAutoblinker(ON, 3, 2);
  roboEyes.setIdleMode(ON, 2, 2);
}

void setEyeMood(EyeSubMode mood) {
  switch (mood) {
    case EYE_DEFAULT: roboEyes.setMood(DEFAULT); break;
    case EYE_ANGRY:   roboEyes.setMood(ANGRY);   break;
    case EYE_TIRED:   roboEyes.setMood(TIRED);   break;
  }
  // No need to call begin again
}

void activateEyesMode(EyeSubMode mode) {
  eyesActive = true;
  currentEyeMode = mode;
  setEyeMood(mode);
  if (mode == EYE_ANGRY || mode == EYE_TIRED) {
    eyeModeStartTime = millis();
  }
  // Debug output
  Serial.print("Activated eyes mode: ");
  Serial.println(mode == EYE_DEFAULT ? "DEFAULT" : (mode == EYE_ANGRY ? "ANGRY" : "TIRED"));
}

// ----------------------------------------------------------------------
//  Process tap count (called after double‑tap timeout)
// ----------------------------------------------------------------------
void processTapCount() {
  if (tapCount == 1) {
    activateEyesMode(EYE_DEFAULT);
  } else if (tapCount == 2) {
    activateEyesMode(EYE_ANGRY);
  }
  tapCount = 0;
  waitingForSecondTap = false;
}

// ----------------------------------------------------------------------
//  Touch sensor handler (with debug)
// ----------------------------------------------------------------------
void handleTouch() {
  int reading = digitalRead(TOUCH_PIN);
  
  // Optional: print raw reading if changed (for debug)
  // if (reading != lastTouchReading) Serial.printf("Touch reading: %d\n", reading);
  
  // Debounce
  if (reading != lastTouchReading) {
    lastTouchChange = millis();
  }
  if ((millis() - lastTouchChange) > DEBOUNCE_DELAY) {
    if (reading != touchPressed) {
      touchPressed = reading;
      if (touchPressed == HIGH) {            // Touch started
        touchStartTime = millis();
        longPressTriggered = false;
        Serial.println("Touch start");
      } else {                               // Touch released
        unsigned long pressDuration = millis() - touchStartTime;
        Serial.printf("Touch release, duration: %lu ms\n", pressDuration);
        
        if (!longPressTriggered && pressDuration < LONG_PRESS_DURATION) {
          // Short tap
          if (!waitingForSecondTap) {
            tapCount = 1;
            waitingForSecondTap = true;
            lastTapTime = millis();
            Serial.println("First tap detected");
          } else {
            if (millis() - lastTapTime <= DOUBLE_TAP_TIMEOUT) {
              tapCount = 2;
              waitingForSecondTap = false;
              Serial.println("Double tap detected");
              processTapCount();
            } else {
              tapCount = 1;
              waitingForSecondTap = false;
              Serial.println("Single tap (timeout)");
              processTapCount();
            }
          }
        }
      }
    }
  }
  lastTouchReading = reading;

  // Long press detection
  if (touchPressed == HIGH && !longPressTriggered) {
    if (millis() - touchStartTime >= LONG_PRESS_DURATION) {
      longPressTriggered = true;
      waitingForSecondTap = false;
      tapCount = 0;
      Serial.println("Long press detected");
      activateEyesMode(EYE_TIRED);
    }
  }

  // Single tap timeout
  if (waitingForSecondTap && (millis() - lastTapTime > DOUBLE_TAP_TIMEOUT)) {
    waitingForSecondTap = false;
    tapCount = 1;
    Serial.println("Single tap (timeout)");
    processTapCount();
  }
}

// =============================================================
// SETUP
// =============================================================
void setup() {
  Serial.begin(115200);
  Serial.println("Starting...");

  // OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println(F("SSD1306 failed"));
    for (;;);
  }
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  // Pins
  pinMode(BUTTON_CLOCK_PIN, INPUT_PULLUP);
  pinMode(BUTTON_TIMER_PIN, INPUT_PULLUP);
  pinMode(BUTTON_START_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(TOUCH_PIN, INPUT);
  digitalWrite(BUZZER_PIN, LOW);

  // Eye library initialization
  setupEyes();   // This calls begin() once
  
  // Quick test of eye moods (to verify library works)
  Serial.println("Testing eye moods...");
  activateEyesMode(EYE_DEFAULT);
  delay(2000);
  activateEyesMode(EYE_ANGRY);
  delay(2000);
  activateEyesMode(EYE_TIRED);
  delay(2000);
  // After test, deactivate eyes
  eyesActive = false;
  Serial.println("Eye test complete.");

  // Static IP + WiFi
  if (!WiFi.config(local_IP, gateway, subnet, primaryDNS, secondaryDNS))
    Serial.println("Static IP config failed");

  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("Connecting WiFi");
  display.display();

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
  Serial.println("\nWiFi connected: " + WiFi.localIP().toString());
  server.begin();

  // NTP
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
  struct tm timeinfo;
  int attempts = 0;
  while (!getLocalTime(&timeinfo) && attempts < 20) { delay(500); attempts++; }

  fetchWeather();
  drawClock();
}

// =============================================================
// LOOP
// =============================================================
void loop() {
  unsigned long now = millis();

  handleWiFiClient();
  handleTouch();          // Check for touch gestures

  // ── TIMER BUTTON 1 (GPIO 33) – multi-click ────────────────────
  bool tb1 = digitalRead(BUTTON_TIMER_PIN);
  if (tb1 == LOW && timerBtn1Prev == HIGH && (now - timerBtn1Debounce) > DEBOUNCE_MS) {
    timerBtn1Debounce = now;
    timerBtn1Count++;
    timerBtn1Last = now;
  }
  timerBtn1Prev = tb1;

  if (timerBtn1Count > 0 && (now - timerBtn1Last) > MULTI_CLICK_WINDOW) {
    processTimerBtn1Count(timerBtn1Count);
  }

  // ── START/STOP BUTTON (GPIO 14) ───────────────────────────────
  bool sb = digitalRead(BUTTON_START_PIN);
  if (sb == LOW && startBtnPrev == HIGH && (now - startBtnDebounce) > DEBOUNCE_MS) {
    startBtnDebounce = now;

    if (currentTimerState != TIMER_NONE) {
      long rem = getRemaining();
      if (rem == 0) {
        timerRunning = false;
        timerSeconds = timerOriginal;
        buzzerActive = false;
        digitalWrite(BUZZER_PIN, LOW);
      } else if (timerRunning) {
        timerSeconds = rem;
        timerRunning = false;
      } else {
        timerStartMs = now;
        timerRunning = true;
      }
    }
  }
  startBtnPrev = sb;

  // ── TIMER EXPIRY CHECK ────────────────────────────────────────
  if (timerRunning) {
    if (getRemaining() == 0) {
      timerSeconds = 0;
      timerRunning = false;
      if (!buzzerActive) {
        buzzerActive     = true;
        buzzerStart      = now;
        lastBuzzerToggle = now;
        buzzerPinState   = HIGH;
        digitalWrite(BUZZER_PIN, HIGH);
      }
    }
  }

  // ── BUZZER PATTERN ────────────────────────────────────────────
  if (buzzerActive) {
    if (now - buzzerStart >= BUZZER_TOTAL) {
      buzzerActive = false;
      digitalWrite(BUZZER_PIN, LOW);
    } else {
      unsigned long elapsed = now - lastBuzzerToggle;
      if ((buzzerPinState == HIGH && elapsed >= BUZZER_ON) ||
          (buzzerPinState == LOW  && elapsed >= BUZZER_OFF)) {
        buzzerPinState = !buzzerPinState;
        digitalWrite(BUZZER_PIN, buzzerPinState ? HIGH : LOW);
        lastBuzzerToggle = now;
      }
    }
  }

  // ── WEATHER REFRESH ──────────────────────────────────────────
  if (WiFi.status() == WL_CONNECTED && (now - lastWeatherFetch > WEATHER_FETCH_INTERVAL))
    fetchWeather();

  // ── CLOCK BUTTON (handles exit from eyes) ─────────────────────
  handleClockButton();

  // ── EYE MODE TIMEOUT (angry/tired → default) ─────────────────
  if (eyesActive) {
    if (currentEyeMode == EYE_ANGRY && (now - eyeModeStartTime >= EYE_ANGRY_DURATION)) {
      activateEyesMode(EYE_DEFAULT);
    } else if (currentEyeMode == EYE_TIRED && (now - eyeModeStartTime >= EYE_TIRED_DURATION)) {
      activateEyesMode(EYE_DEFAULT);
    }
  }

  // ── DISPLAY LOGIC ────────────────────────────────────────────
  if (eyesActive) {
    roboEyes.update(); // draw animated eyes
  } else {
    // Normal display modes
    if (currentTimerState != TIMER_NONE) {
      if (now - lastDisplayUpdate >= DISPLAY_INTERVAL) {
        lastDisplayUpdate = now;
        const char* label = (currentTimerState == TIMER_45MIN) ? "   Timer: 45 minute" : "   Timer: 10 minute";
        drawTimer(label, getRemaining());
      }
    } else if (notificationActive) {
      if (now - lastBlinkTime >= BLINK_INTERVAL) {
        lastBlinkTime = now;
        blinkState = !blinkState;
      }
      drawNotification();
    } else {
      // Auto-return uptime/weather → clock
      if ((currentClockMode == MODE_UPTIME || currentClockMode == MODE_WEATHER) &&
          (now - modeStartTime > MODE_DURATION)) {
        currentClockMode = MODE_CLOCK;
      }

      if (now - lastDisplayUpdate >= NORMAL_UPDATE_INTERVAL) {
        lastDisplayUpdate = now;
        switch (currentClockMode) {
          case MODE_CLOCK:   drawClock();   break;
          case MODE_UPTIME:  drawUptime();  break;
          case MODE_WEATHER: drawWeather(); break;
        }
      }
    }
  }

  delay(10);
}
